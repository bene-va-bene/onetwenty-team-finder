# Add these to .env.local. Never commit real values or use NEXT_PUBLIC_ for secrets.
APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SMTP_PASSWORD=replace-with-teamfinder-mailbox-password
CRON_SECRET=replace-with-at-least-32-random-characters
# Sender/user: teamfinder@rad-race.com; host smtp.strato.de; TLS port 465.
# For production use the final HTTPS origin for APP_URL.
